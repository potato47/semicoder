{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client", "@cloudflare/workers-types", "bun"]
  },
  "include": ["src", "scripts", "tests", "*.ts"],
  "exclude": ["node_modules", "dist", ".wrangler", "worker-configuration.d.ts"]
}
